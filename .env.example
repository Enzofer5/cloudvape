# Copiá este archivo como .env y completá los valores reales.
# NUNCA subas el archivo .env a un repositorio.

FLASK_APP=run.py
FLASK_ENV=development
# Generá una clave con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# Conexión MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vapeshop
DB_USER=vapeshop_user
DB_PASSWORD=cambiar_password

# Poner en 1 cuando el sitio corra bajo HTTPS
SESSION_COOKIE_SECURE=0

# Tienda
STORE_NAME=.vape
SHIPPING_FLAT_COST=3500
FREE_SHIPPING_FROM=60000
MIN_CUSTOMER_AGE=18

# SMTP para recuperación de contraseña (si se deja vacío, el enlace se muestra en la consola)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@cloudvape.local
