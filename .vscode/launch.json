{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Tienda .vape (Flask)",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "cwd": "${workspaceFolder}",
      "env": {
        "FLASK_APP": "run.py",
        "FLASK_DEBUG": "1"
      },
      "args": [
        "run",
        "--port",
        "5000"
      ],
      "jinja": true,
      "justMyCode": true
    }
  ]
}
